{
  "manifest_version": 3,
  "name": "Mac Mode for WhatsApp Web",
  "version": "1.0.1",
  "description": "Mac app shortcuts, SF Pro, and right-to-left fixes for WhatsApp Web. Unofficial; not affiliated with WhatsApp or Meta.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "css": [
        "styles/native.css",
        "styles/bidi.css",
        "styles/nags.css",
        "styles/indicator.css"
      ],
      "js": [
        "selectors.js",
        "indicator.js",
        "health.js",
        "content.js",
        "bidi.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
