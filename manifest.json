{
  "manifest_version": 3,
  "name": "WhatsApp Web Native",
  "version": "0.1.0",
  "description": "Makes WhatsApp Web look and behave more like the WhatsApp Mac app.",
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "css": ["styles/native.css", "styles/bidi.css", "styles/nags.css"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
